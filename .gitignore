# build
/target/
**/*.rs.bk

# agent/tooling state
.claude/
.codex/
.cursor/
.aider*

# editors / OS
.vscode/
.idea/
.DS_Store

# node (wasm wrapper dev)
node_modules/
pkg/

# local databases & scratch
*.plugmem
*.journal
scratch/
bench-history/local-*
*-benchmark-*.tsv

# coverage reports (cargo tarpaulin)
/coverage/
**/cobertura.xml
**/lcov.info
**/tarpaulin-report.html

# cargo-fuzz build output and run state. `fuzz/seeds/` is the committed input
# set; `fuzz/corpus/` is the fuzzer's own working corpus, which it grows by
# thousands of files per run and which is derived from the seeds.
/fuzz/target/
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/corpus/
# The seeds are committed inputs, not scratch — `*.journal` and `*.plugmem`
# above would otherwise swallow them.
!/fuzz/seeds/**
